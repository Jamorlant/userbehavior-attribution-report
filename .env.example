# 复制为 .env 后按需修改；所有变量都有默认值，不配置也能跑。
# 相对路径按仓库根目录解析。

# 数据源：真实数据集为 Parquet（1.0015 亿行 / 1.06 GB），不在仓库内。
# 不设置时回退到仓库内 100 万行合成数据（仅用于 CI / 冒烟，不是报告结论来源）。
UBA_DATA_PATH=data/userbehavior.csv.gz

# 输出目录
UBA_OUTPUT_DIR=outputs
UBA_FIGURES_DIR=figures
UBA_REPORT_DIR=report
# DuckDB 磁盘库与临时文件目录（1 亿行事件表约 4 GB）
UBA_CACHE_DIR=build

# DuckDB 算力参数：内存上限与线程数；15 GB 机器建议 8GB / 8 线程
UBA_DUCKDB_MEMORY=8GB
UBA_DUCKDB_THREADS=8

# 观测窗校正：距数据末尾不足该小时数的加购视为删失（不计入成交率分母）
UBA_CENSOR_WINDOW_HOURS=48

# 官方时间窗（Asia/Shanghai）；窗口外记录会被剔除并计数
UBA_WINDOW_START=2017-11-25
UBA_WINDOW_END=2017-12-03

# 合成回退数据的随机种子（改种子 = 换一份数据，结论不应直接沿用）
UBA_SEED=42

# DEBUG / INFO / WARNING / ERROR
UBA_LOG_LEVEL=INFO
